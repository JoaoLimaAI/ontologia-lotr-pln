lotr:PortadorDeAnel a owl:Class ;
    rdfs:label "Portador de Anel"@pt ;
    rdfs:comment "Classe DEFINIDA: equivale a quem já teve posse de algum Anel de Poder (inferida pelo raciocinador)."@pt ;
    rdfs:subClassOf lotr:Personagem ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( lotr:Personagem [ a owl:Restriction ;
                        owl:onProperty lotr:jaPortou ;
                        owl:someValuesFrom lotr:AnelDePoder ] ) ] .

